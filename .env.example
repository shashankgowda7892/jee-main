# Database Configuration
DB_NAME=jee_main_db
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
DB_POOL_MAX=30
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
