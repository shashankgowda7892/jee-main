# Database Configuration
DB_NAME=jee_main_db
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
DB_POOL_MAX=30
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API
WHATSAPP_TOKEN=YOUR_PERMANENT_ACCESS_TOKEN   # Access token from Meta Developer Console
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID   # Phone number ID from Meta Developer Console

# Webhook verification
VERIFY_TOKEN=YOUR_CUSTOM_VERIFY_TOKEN        # Any string to verify WhatsApp webhook
